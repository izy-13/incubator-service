              ]
            },
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/users?sortBy=createdAt&sortDirection=desc&pageNumber=1&pageSize=10",
            "description": "Basic auth. Paginated list. Optional: searchLoginTerm, searchEmailTerm. 200 OK."
